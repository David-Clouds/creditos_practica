@model CreditosPlataforma.Web.Models.ViewModels.RegistroSolicitudViewModel

@{
    ViewData["Title"] = "Nueva solicitud";
}

<h1>➕ Nueva solicitud de crédito</h1>

@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alert alert-success">✅ @Model.MensajeExito</div>
}

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger">⚠️ @Model.MensajeError</div>
}

<form asp-action="Registrar" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="MontoSolicitado" class="form-label"></label>
        <input asp-for="MontoSolicitado" class="form-control" placeholder="Ej. 5000" />
        <span asp-validation-for="MontoSolicitado" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Registrar solicitud</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Ver mis solicitudes</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}