@model CreditosPlataforma.Web.Models.SolicitudCredito

@{
    ViewData["Title"] = "Detalle de solicitud";
}

<h1>Detalle de solicitud #@Model.Id</h1>

<div data-solicitud-id="@Model.Id">
    <dl class="row">
        <dt class="col-sm-3">Monto solicitado</dt>
        <dd class="col-sm-9">S/ @Model.MontoSolicitado.ToString("N2")</dd>

        <dt class="col-sm-3">Fecha de solicitud</dt>
        <dd class="col-sm-9">@Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">
            <span data-estado-badge class="badge bg-@(Model.Estado == CreditosPlataforma.Web.Models.EstadoSolicitud.Aprobado ? "success" : Model.Estado == CreditosPlataforma.Web.Models.EstadoSolicitud.Rechazado ? "danger" : "warning")">
                @Model.Estado
            </span>
        </dd>

        <div data-motivo-contenedor class="@(string.IsNullOrEmpty(Model.MotivoRechazo) ? "d-none" : "")">
            <dt class="col-sm-3">Motivo de rechazo</dt>
            <dd class="col-sm-9"><span data-motivo-rechazo>@Model.MotivoRechazo</span></dd>
        </div>
    </dl>
</div>

<a asp-action="Index" class="btn btn-secondary">← Volver al listado</a>