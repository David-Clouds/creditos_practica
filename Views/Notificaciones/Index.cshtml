@model IEnumerable<CreditosPlataforma.Web.Models.Notificacion>

@{
    ViewData["Title"] = "Mis notificaciones";
}

<h1>🔔 Mis notificaciones</h1>

@if (!Model.Any())
{
    <p class="text-muted">No tienes notificaciones todavía.</p>
}
else
{
    <ul class="list-group">
        @foreach (var n in Model)
        {
            <li class="list-group-item">
                <div>@n.Texto</div>
                <small class="text-muted">@n.FechaProcesamientoUtc.ToString("dd/MM/yyyy HH:mm") UTC</small>
            </li>
        }
    </ul>
}